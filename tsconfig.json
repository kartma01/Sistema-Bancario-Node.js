{
  "compilerOptions": {
    /* Layout do Projeto */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Ambiente e Módulos */
    "module": "commonjs",
    "target": "es2022",
    "types": ["node"],

    /* Arquivos de Suporte */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Tipagem Estrita (Foco no Aprendizado!) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}